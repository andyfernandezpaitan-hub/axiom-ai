# Copia este archivo como .env y completa los valores. Nunca subas .env a git.

# Proveedor del tutor: "openjarvis" (local) o vacío para Anthropic
AXIOM_PROVIDER=openjarvis
AXIOM_OPENJARVIS_URL=http://localhost:8000
# ANTHROPIC_API_KEY=

# API de AXIOM (npm run api)
AXIOM_API_PORT=3000
# AXIOM_DB_PATH=data/axiom.db
